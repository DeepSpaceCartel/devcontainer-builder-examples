{
  "name": "docs-demo",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Web app", "protocol": "http" }
